{
  "name": "configurable-pricing-engine",
  "version": "1.1.0",
  "private": true,
  "description": "A reusable, configuration-driven TypeScript pricing and quote calculation engine.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:demo",
    "build:core": "tsc -p tsconfig.json",
    "build:demo": "esbuild demo/app.ts --bundle --format=iife --outfile=demo/app.js",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry": "npm run build && wrangler deploy --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "wrangler": "^4.34.0"
  }
}
